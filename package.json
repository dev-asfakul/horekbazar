{
  "name": "horekbazar",
  "version": "0.0.0",
  "private": true,
  "description": "HorekBazar: a reusable, self-hosted single-store e-commerce template (Bangladesh, COD-first, bilingual).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/patch-next-empty-rsc.mjs",
    "prebuild": "node scripts/patch-next-empty-rsc.mjs",
    "build": "next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:db": "playwright test -c playwright.db.config.ts",
    "check:bundle": "node scripts/check-bundle-secrets.mjs",
    "catalogue:validate": "node catalogue/horekbazar/tools/catalogue.mjs validate",
    "catalogue:schema": "node scripts/validate-catalogue-schema.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:validators": "node scripts/db-validators.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.ts",
    "showcase": "node --env-file-if-exists=.env.local scripts/showcase.ts",
    "showcase:images": "node --env-file-if-exists=.env.local scripts/showcase-images.ts",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.ts",
    "admin:recover-owner": "node --env-file-if-exists=.env.local scripts/admin-recover-owner.ts",
    "owner:bootstrap": "node --env-file-if-exists=.env.local scripts/owner-bootstrap.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "better-auth": "1.7.12",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "11.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
