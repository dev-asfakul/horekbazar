# HorekBazar template: environment variables
# Copy to .env.local and fill in your own values. Never commit .env files.
# STATUS: provisional. Variable set follows the stack PROPOSED at Motomation
# Checkpoint 1 (see DESIGN.md) and will change if that proposal is revised.
#
# Every integration is optional except where marked REQUIRED FOR COMMERCE.
# With nothing set, the app runs in read-only demo mode from data/.

# ── Core ────────────────────────────────────────────────────────────────
# Public base URL of this installation (canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default locale and timezone for this store
NEXT_PUBLIC_DEFAULT_LOCALE=bn
STORE_TIMEZONE=Asia/Dhaka

# ── Database: MongoDB (REQUIRED FOR COMMERCE: accounts, cart, orders) ────
# Atlas connection string. Use a dedicated database user with least privilege.
MONGODB_URI=
MONGODB_DB=horekbazar

# ── Authentication ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google sign-in (optional; hidden when unset)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ── Cache and rate limiting: Redis (optional; in-process fallback in dev) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Media: Cloudinary (optional; local demo images used when unset) ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Transactional email: Resend (optional; emails logged in dev) ────────
RESEND_API_KEY=
EMAIL_FROM=

# ── Browser push: VAPID keys (optional; push opt-in hidden when unset) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ── AI content assistant: Gemini (optional; feature hidden when unset) ──
GEMINI_API_KEY=

# ── Couriers (optional; manual tracking links when unset) ───────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
# Shared secret used to verify inbound courier webhooks
COURIER_WEBHOOK_SECRET=

# ── Realtime chat (optional; polling fallback when unset) ───────────────
ABLY_API_KEY=

# ── Scheduled jobs ──────────────────────────────────────────────────────
# Bearer secret that cron/job endpoints require
CRON_SECRET=
