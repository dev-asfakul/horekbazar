# HorekBazar template: environment variables
# Copy to .env.local and fill in your own values. Never commit .env files.
# STATUS: provisional. Variable set follows the stack PROPOSED at Motomation
# Checkpoint 1 (see DESIGN.md) and will change if that proposal is revised.
#
# Placeholders only. Use separate values for development, staging and production;
# never reuse credentials across environments.
# MONGODB_URI is required for every database-backed page; without it the app shows a
# setup-required screen (no fallback data). Other integrations are required only by
# the operation that uses them and are otherwise hidden or disabled with a notice.

# ── Core ────────────────────────────────────────────────────────────────
# Public base URL of this installation (canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default locale and timezone for this store
NEXT_PUBLIC_DEFAULT_LOCALE=bn
STORE_TIMEZONE=Asia/Dhaka
# Maintenance mode: "on" shows the maintenance page (HTTP 503) on every storefront page
MAINTENANCE_MODE=off
# Search-engine indexing: "on" allows crawling (robots.txt). Keep "off" until the owner launches
SITE_INDEXING=off

# ── Database: MongoDB (REQUIRED: catalogue, accounts, cart, orders) ────────
# Atlas connection string. Use a dedicated database user with least privilege.
# Must be a replica set (every Atlas cluster is; locally `mongod --replSet rs0`, initiated once).
# A standalone mongod is refused: orders need multi-document transactions (domain-rules §12).
MONGODB_URI=
MONGODB_DB=horekbazar

# ── Authentication ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# First-owner setup token: /admin/setup asks for it, so only the person who deployed the store can
# create the first Owner. Generate with: openssl rand -base64 24. Remove it after setup if you like.
SETUP_TOKEN=
# Google sign-in (optional; hidden when unset)
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# ── Cache and rate limiting: Redis (required in staging/production) ──────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Media: Cloudinary (required for image upload; existing image URLs still render)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Transactional email: Resend (required for verification/reset/order emails)
RESEND_API_KEY=
EMAIL_FROM=

# ── Browser push: VAPID keys (optional; push opt-in hidden when unset) ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:

# ── AI content assistant: Gemini (optional; feature hidden when unset) ──
GEMINI_API_KEY=

# ── Couriers (optional; manual tracking links when unset) ───────────────
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
# Shared secret used to verify inbound courier webhooks
COURIER_WEBHOOK_SECRET=

# ── Realtime chat (optional; polling fallback when unset) ───────────────
ABLY_API_KEY=

# ── Scheduled jobs (outbox drain, docs/domain-rules.md §13) ─────────────
# How the outbox is drained: "worker" (a separate `npm run worker` process; self-hosting and
# local development) or "http" (an external scheduler calls POST /api/jobs/drain with
# CRON_SECRET). Never an in-process timer in the web server. Unset: health shows "not configured".
JOBS_TRIGGER=
# Bearer secret that cron/job endpoints require (at least 16 characters; generate with
# `openssl rand -base64 32`). Different value per environment.
CRON_SECRET=

# ── Tests only (Playwright; never needed to run the store) ──────────────
# Port of the local production server the browser tests start (default 3100)
E2E_PORT=
# Port of the test-only HTTPS proxy used for WebKit (default 3443)
E2E_HTTPS_PORT=
# Port of the second server started with MAINTENANCE_MODE=on (default 3101)
E2E_MAINTENANCE_PORT=
# Set to 1 to capture review screenshots into test-results/screenshots
E2E_SCREENSHOTS=
# Port of the production server backed by a disposable in-memory database (npm run test:e2e:db; default 3200)
E2E_DB_PORT=
# MongoDB version mongodb-memory-server downloads for integration and test:e2e:db (default 8.0.4)
MONGOMS_VERSION=
