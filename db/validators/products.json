              "bn"
            ],
            "additionalProperties": false
          },
          "description": {
            "bsonType": "object",
            "properties": {
              "bn": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 170
              },
              "en": {
                "bsonType": "string",
                "minLength": 1,
                "maxLength": 170
              }
            },
            "required": [
              "bn"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "publishedAt": {
        "bsonType": "date"
      },
      "sample": {
        "bsonType": "bool",
        "enum": [
          true
        ]
      },
      "version": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updatedAt": {
        "bsonType": "date"
      }
    },
    "required": [
      "_id",
      "slug",
      "name",
      "primaryCategoryId",
      "categoryIds",
      "attributes",
      "media",
      "status",
      "version",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
