{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "userId": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "kind": {
        "bsonType": "string",
        "enum": [
          "export",
          "deletion"
        ]
      },
      "status": {
        "bsonType": "string",
        "enum": [
          "ready",
          "completed",
          "received",
          "cancelled"
        ]
      },
      "token": {
        "bsonType": "string",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      },
      "expiresAt": {
        "bsonType": "date"
      },
      "completedAt": {
        "bsonType": "date"
      },
      "cancelledAt": {
        "bsonType": "date"
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updatedAt": {
        "bsonType": "date"
      }
    },
    "required": [
      "_id",
      "userId",
      "kind",
      "status",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
