{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "key": {
        "bsonType": "string",
        "pattern": "^[a-z][a-z0-9_]{1,39}$"
      },
      "name": {
        "bsonType": "object",
        "properties": {
          "bn": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "en": {
            "bsonType": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "bn"
        ],
        "additionalProperties": false
      },
      "capabilities": {
        "bsonType": "array",
        "items": {
          "bsonType": "string",
          "enum": [
            "platform.read",
            "staff.manage",
            "settings.write",
            "settings.integrations.write",
            "delivery.write",
            "catalogue.write",
            "merch.write",
            "inventory.adjust",
            "promotions.write",
            "campaigns.send",
            "rewards.write",
            "orders.read",
            "orders.note",
            "orders.request_cancel",
            "orders.confirm",
            "fulfilment.write",
            "returns.process",
            "customers.read",
            "customers.export",
            "reviews.moderate",
            "messages.reply",
            "reports.read"
          ]
        }
      },
      "builtIn": {
        "bsonType": "bool"
      },
      "twoFactorRequired": {
        "bsonType": "bool"
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updatedAt": {
        "bsonType": "date"
      }
    },
    "required": [
      "_id",
      "key",
      "name",
      "capabilities",
      "builtIn",
      "twoFactorRequired",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
