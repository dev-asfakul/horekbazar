{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "name": {
        "bsonType": "string",
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_.-]*$"
      },
      "lastRunAt": {
        "bsonType": "date"
      },
      "lastResult": {
        "bsonType": "object",
        "properties": {
          "ok": {
            "bsonType": "bool"
          },
          "trigger": {
            "bsonType": "string",
            "enum": [
              "worker",
              "http"
            ]
          },
          "claimed": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 0
          },
          "done": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 0
          },
          "retried": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 0
          },
          "dead": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 0
          },
          "durationMs": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 0
          },
          "error": {
            "bsonType": "string",
            "maxLength": 500
          }
        },
        "required": [
          "ok",
          "trigger",
          "claimed",
          "done",
          "retried",
          "dead",
          "durationMs"
        ],
        "additionalProperties": false
      },
      "lastSuccessAt": {
        "bsonType": "date"
      },
      "lockUntil": {
        "bsonType": "date"
      },
      "lockOwner": {
        "bsonType": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "lastAcceptedAt": {
        "bsonType": "date"
      },
      "accepted": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 0
      },
      "skippedLocked": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 0
      },
      "skippedInterval": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 0
      },
      "lastSkippedAt": {
        "bsonType": "date"
      },
      "lastSkipReason": {
        "bsonType": "string",
        "enum": [
          "locked",
          "interval"
        ]
      }
    },
    "required": [
      "_id",
      "name"
    ],
    "additionalProperties": false
  }
}
