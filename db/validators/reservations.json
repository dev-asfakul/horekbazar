{
  "$jsonSchema": {
    "bsonType": "object",
    "properties": {
      "_id": {
        "bsonType": "objectId"
      },
      "orderId": {
        "bsonType": "objectId"
      },
      "lineId": {
        "bsonType": "string",
        "pattern": "^[a-f0-9]{24}$"
      },
      "variantId": {
        "bsonType": "objectId"
      },
      "qty": {
        "bsonType": [
          "int",
          "long"
        ],
        "minimum": 1,
        "maximum": 99
      },
      "status": {
        "bsonType": "string",
        "enum": [
          "active",
          "committed",
          "released"
        ]
      },
      "createdAt": {
        "bsonType": "date"
      },
      "updatedAt": {
        "bsonType": "date"
      }
    },
    "required": [
      "_id",
      "orderId",
      "lineId",
      "variantId",
      "qty",
      "status",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  }
}
