coverage/
playwright-report/
test-results/
blob-report/
loadtest/results/

# Logs and OS noise
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Agent tooling: the Motomation Design skill is installed per machine from
