# Dependencies
node_modules/
.pnpm-store/

# Next.js / build output
.next/
out/
build/
dist/
.vercel/
*.tsbuildinfo
next-env.d.ts

# Environment and secrets: only .env.example is committed
.env
.env.*
!.env.example
*.pem
*.key
secrets/

